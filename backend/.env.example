# Frontend URL (used for redirect from GET /)
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed by CORS
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Server port (default: 5000)
# PORT=5000

# Max upload size in bytes (default: 104857600 = 100 MB)
# MAX_CONTENT_LENGTH=104857600

# Set to false in production (REQUIRED for production)
FLASK_DEBUG=false

# Demo mode: always heatmap, varied scores, never crash (safe fallback)
# DEMO_MODE=false

# TRUTHSHIELD Backend Production Environment
# Copy this to .env and update with your production values

# Frontend URL (REQUIRED - update with your domain)
FRONTEND_URL=https://yourdomain.com

# CORS origins (REQUIRED - comma-separated list of allowed origins)
CORS_ORIGINS=https://yourdomain.com

# Server port
PORT=5000

# Max upload size in bytes (100 MB)
MAX_CONTENT_LENGTH=104857600

# CRITICAL: Set to false in production
FLASK_DEBUG=false
